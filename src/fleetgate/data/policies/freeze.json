{
  "version": 1,
  "name": "freeze",
  "description": "Release freeze: only REVERSIBLE runbooks may run; a weekly maintenance window re-opens disruptive work in dc1.",
  "protected_roles": ["db-primary", "validator"],
  "max_drained_fraction": 0.10,
  "cooldown_ticks": 5,
  "max_actions_per_tick": 3,
  "deny_list": ["decommission_host"],
  "freeze_windows": [{"start": 0, "end": 1000000, "allow_tiers": ["REVERSIBLE"], "label": "release freeze"}],
  "maintenance_windows": [{"start": 40, "end": 48, "repeat_every": 336, "dcs": ["dc1"], "label": "weekly dc1 window"}],
  "quotas": {"window_ticks": 24, "per_role": {}, "per_dc": {}},
  "approvals": {
    "DESTRUCTIVE": {"required": 2, "roles": ["sre-lead", "dc-ops"]},
    "DISRUPTIVE": {"required": 1, "roles": ["sre", "sre-lead"]},
    "protected": {"required": 1, "roles": ["sre-lead", "db-owner"]}
  },
  "escalation": {"page_after_ticks": 3, "expire_after_ticks": 12},
  "rate_limits": {},
  "canary": {"enabled": true, "fleet_fraction": 0.05, "window_ticks": 10, "canary_count": 1},
  "min_active_per_role": {"db-primary": 1, "validator": 1}
}
