{
  "version": 1,
  "runbooks": [
    {
      "id": "set_fan_profile_max",
      "tier": "REVERSIBLE",
      "description": "Pin chassis fans to max RPM via the BMC",
      "effects": [{"op": "clear_fault", "fault": "thermal"}, {"op": "set_state", "field": "fan_profile", "value": "max"}],
      "preconditions": ["bmc_reachable"],
      "verify": [{"metric": "temp_c", "op": "<", "value": 85}],
      "rollback": "set_fan_profile_auto",
      "duration_ticks": 1,
      "tags": ["thermal", "bmc"]
    },
    {
      "id": "set_fan_profile_auto",
      "tier": "REVERSIBLE",
      "description": "Return chassis fans to the automatic profile",
      "effects": [{"op": "set_state", "field": "fan_profile", "value": "auto"}],
      "preconditions": ["bmc_reachable"],
      "verify": [{"state": "fan_profile", "equals": "auto"}],
      "rollback": "set_fan_profile_max",
      "duration_ticks": 1,
      "tags": ["thermal", "bmc"]
    },
    {
      "id": "restart_service",
      "tier": "REVERSIBLE",
      "description": "Restart the workload service (frees leaked memory, clears OOM state)",
      "effects": [{"op": "clear_faults", "faults": ["service_down", "memory_leak", "oom_kills", "zombie_growth"]}],
      "preconditions": ["ssh_reachable"],
      "verify": [{"metric": "service_up", "op": ">=", "value": 1}],
      "rollback": null,
      "duration_ticks": 1,
      "tags": ["software"]
    },
    {
      "id": "reset_nic",
      "tier": "REVERSIBLE",
      "description": "Bounce the NIC link and reload the driver",
      "effects": [{"op": "clear_faults", "faults": ["nic_errors", "link_flap", "packet_loss"]}],
      "preconditions": ["ssh_reachable"],
      "verify": [{"metric": "nic_crc_per_min", "op": "<", "value": 200}, {"metric": "packet_loss_pct", "op": "<", "value": 2}],
      "rollback": null,
      "duration_ticks": 1,
      "tags": ["network"]
    },
    {
      "id": "drain_host",
      "tier": "REVERSIBLE",
      "description": "Cordon and drain workloads off the host",
      "effects": [{"op": "set_state", "field": "drained", "value": true}],
      "preconditions": ["host_not_drained"],
      "verify": [{"state": "drained", "equals": true}],
      "rollback": "undrain_host",
      "duration_ticks": 2,
      "tags": ["capacity"]
    },
    {
      "id": "undrain_host",
      "tier": "REVERSIBLE",
      "description": "Return a drained host to the scheduler",
      "effects": [{"op": "set_state", "field": "drained", "value": false}],
      "preconditions": ["host_drained"],
      "verify": [{"state": "drained", "equals": false}],
      "rollback": "drain_host",
      "duration_ticks": 1,
      "tags": ["capacity"]
    },
    {
      "id": "cordon_host",
      "tier": "REVERSIBLE",
      "description": "Stop scheduling new workloads on the host (existing ones keep running)",
      "effects": [{"op": "set_state", "field": "cordoned", "value": true}],
      "preconditions": ["host_not_cordoned"],
      "verify": [{"state": "cordoned", "equals": true}],
      "rollback": "uncordon_host",
      "duration_ticks": 0,
      "tags": ["capacity"]
    },
    {
      "id": "uncordon_host",
      "tier": "REVERSIBLE",
      "description": "Allow scheduling on the host again",
      "effects": [{"op": "set_state", "field": "cordoned", "value": false}],
      "preconditions": ["host_cordoned"],
      "verify": [{"state": "cordoned", "equals": false}],
      "rollback": "cordon_host",
      "duration_ticks": 0,
      "tags": ["capacity"]
    },
    {
      "id": "open_ticket",
      "tier": "REVERSIBLE",
      "description": "Open a DC-ops hardware ticket for the host",
      "effects": [{"op": "set_state", "field": "ticketed", "value": true}],
      "preconditions": [],
      "verify": [{"state": "ticketed", "equals": true}],
      "rollback": null,
      "duration_ticks": 0,
      "tags": ["ticketing"]
    },
    {
      "id": "resync_ntp",
      "tier": "REVERSIBLE",
      "description": "Force an NTP step and restart chrony",
      "effects": [{"op": "clear_fault", "fault": "ntp_drift"}],
      "preconditions": ["ssh_reachable"],
      "verify": [{"metric": "ntp_offset_ms", "op": "abs<", "value": 500}],
      "rollback": null,
      "duration_ticks": 1,
      "tags": ["time"]
    },
    {
      "id": "kill_zombie_processes",
      "tier": "REVERSIBLE",
      "description": "Signal the parent to reap, then kill orphaned zombies",
      "effects": [{"op": "clear_fault", "fault": "zombie_growth"}],
      "preconditions": ["ssh_reachable"],
      "verify": [{"metric": "zombie_procs", "op": "<", "value": 200}],
      "rollback": null,
      "duration_ticks": 1,
      "tags": ["software"]
    },
    {
      "id": "throttle_workload",
      "tier": "REVERSIBLE",
      "description": "Halve the workload's CPU quota to shed heat and load",
      "effects": [{"op": "set_state", "field": "throttled", "value": true}],
      "preconditions": ["host_not_throttled"],
      "verify": [{"state": "throttled", "equals": true}],
      "rollback": "unthrottle_workload",
      "duration_ticks": 1,
      "tags": ["thermal", "capacity"]
    },
    {
      "id": "unthrottle_workload",
      "tier": "REVERSIBLE",
      "description": "Restore the workload's full CPU quota",
      "effects": [{"op": "set_state", "field": "throttled", "value": false}],
      "preconditions": ["host_throttled"],
      "verify": [{"state": "throttled", "equals": false}],
      "rollback": "throttle_workload",
      "duration_ticks": 1,
      "tags": ["thermal", "capacity"]
    },
    {
      "id": "rotate_cert",
      "tier": "REVERSIBLE",
      "description": "Issue and install a fresh host TLS certificate",
      "effects": [{"op": "clear_fault", "fault": "cert_expiry"}],
      "preconditions": ["ssh_reachable"],
      "verify": [{"metric": "cert_days_left", "op": ">", "value": 30}],
      "rollback": null,
      "duration_ticks": 1,
      "tags": ["security"]
    },
    {
      "id": "reset_bmc",
      "tier": "REVERSIBLE",
      "description": "Cold-reset the BMC (does not affect the host OS)",
      "effects": [{"op": "clear_fault", "fault": "bmc_unreachable"}],
      "preconditions": [],
      "verify": [{"metric": "bmc_reachable", "op": ">=", "value": 1}],
      "rollback": null,
      "duration_ticks": 2,
      "tags": ["bmc"]
    },
    {
      "id": "failover_tor_uplink",
      "tier": "REVERSIBLE",
      "description": "Fail the rack over to its secondary ToR uplink (applies to every host in the rack)",
      "effects": [{"op": "clear_faults", "faults": ["uplink_loss", "packet_loss"]}],
      "preconditions": [],
      "verify": [{"metric": "packet_loss_pct", "op": "<", "value": 2}],
      "rollback": null,
      "duration_ticks": 1,
      "scope": "rack",
      "tags": ["network", "rack"]
    },
    {
      "id": "restore_rack",
      "tier": "REVERSIBLE",
      "description": "Return every host in the rack to the scheduler after a rack migration",
      "effects": [{"op": "set_state", "field": "drained", "value": false}],
      "preconditions": ["host_drained"],
      "verify": [{"state": "drained", "equals": false}],
      "rollback": null,
      "duration_ticks": 1,
      "scope": "rack",
      "tags": ["capacity", "rack"]
    },
    {
      "id": "reboot_host",
      "tier": "DISRUPTIVE",
      "description": "Clean reboot of the host OS (workloads must be drained first)",
      "effects": [{"op": "clear_faults", "faults": ["service_down", "memory_leak", "oom_kills", "zombie_growth", "kernel_soft_lockup", "swap_exhaustion", "ntp_drift", "ssh_unreachable"]}],
      "preconditions": ["host_drained"],
      "verify": [{"metric": "ssh_reachable", "op": ">=", "value": 1}, {"metric": "soft_lockups_per_h", "op": "<", "value": 1}],
      "rollback": null,
      "duration_ticks": 3,
      "tags": ["software", "power"]
    },
    {
      "id": "power_cycle_host",
      "tier": "DISRUPTIVE",
      "description": "Hard power cycle through the BMC when the OS is unresponsive",
      "effects": [{"op": "clear_faults", "faults": ["service_down", "memory_leak", "oom_kills", "zombie_growth", "kernel_soft_lockup", "swap_exhaustion", "ntp_drift", "ssh_unreachable", "cpu_throttling"]}],
      "preconditions": ["host_drained", "bmc_reachable"],
      "verify": [{"metric": "ssh_reachable", "op": ">=", "value": 1}],
      "rollback": null,
      "duration_ticks": 4,
      "tags": ["power", "bmc"]
    },
    {
      "id": "raid_rebuild",
      "tier": "DISRUPTIVE",
      "description": "Add the hot spare and rebuild the degraded array (heavy I/O for hours)",
      "effects": [{"op": "clear_fault", "fault": "raid_degraded"}],
      "preconditions": [],
      "verify": [{"metric": "raid_degraded", "op": "<", "value": 1}],
      "rollback": null,
      "duration_ticks": 6,
      "tags": ["storage"]
    },
    {
      "id": "reset_gpu",
      "tier": "DISRUPTIVE",
      "description": "Reset the GPU and reload the driver (kills running GPU jobs)",
      "effects": [{"op": "clear_fault", "fault": "gpu_xid"}],
      "preconditions": ["host_drained"],
      "verify": [{"metric": "gpu_xid_per_h", "op": "<", "value": 1}],
      "rollback": null,
      "duration_ticks": 2,
      "tags": ["gpu"]
    },
    {
      "id": "swapoff_swapon",
      "tier": "DISRUPTIVE",
      "description": "Cycle swap to force pages back into RAM (stalls the host briefly)",
      "effects": [{"op": "clear_fault", "fault": "swap_exhaustion"}],
      "preconditions": ["ssh_reachable"],
      "verify": [{"metric": "swap_used_pct", "op": "<", "value": 80}],
      "rollback": null,
      "duration_ticks": 1,
      "tags": ["software"]
    },
    {
      "id": "purge_inode_tmp",
      "tier": "DISRUPTIVE",
      "description": "Delete temp and cache files to free inodes (not recoverable)",
      "effects": [{"op": "clear_fault", "fault": "inode_exhaustion"}],
      "preconditions": ["ssh_reachable"],
      "verify": [{"metric": "inode_used_pct", "op": "<", "value": 95}],
      "rollback": null,
      "duration_ticks": 1,
      "tags": ["storage"]
    },
    {
      "id": "firmware_update",
      "tier": "DISRUPTIVE",
      "description": "Flash BIOS/BMC to the fleet baseline and reboot",
      "effects": [{"op": "clear_fault", "fault": "firmware_mismatch"}],
      "preconditions": ["host_drained", "bmc_reachable"],
      "verify": [{"metric": "fw_mismatch", "op": "<", "value": 1}],
      "rollback": null,
      "duration_ticks": 5,
      "tags": ["firmware", "bmc"]
    },
    {
      "id": "migrate_workloads",
      "tier": "DISRUPTIVE",
      "description": "Live-migrate every workload off the rack (drains all hosts in the rack)",
      "effects": [{"op": "set_state", "field": "drained", "value": true}],
      "preconditions": ["host_not_drained"],
      "verify": [{"state": "drained", "equals": true}],
      "rollback": "restore_rack",
      "duration_ticks": 3,
      "scope": "rack",
      "tags": ["capacity", "rack"]
    },
    {
      "id": "replace_fan",
      "tier": "DISRUPTIVE",
      "description": "DC-ops hot-swaps the failed chassis fan (needs a ticket)",
      "effects": [{"op": "clear_fault", "fault": "fan_failure"}],
      "preconditions": ["ticket_open"],
      "verify": [{"metric": "fan_rpm", "op": ">", "value": 5000}],
      "rollback": null,
      "duration_ticks": 8,
      "tags": ["hardware", "dc-ops"]
    },
    {
      "id": "replace_psu",
      "tier": "DISRUPTIVE",
      "description": "DC-ops hot-swaps the failed PSU (needs a ticket)",
      "effects": [{"op": "clear_fault", "fault": "psu_failure"}],
      "preconditions": ["ticket_open"],
      "verify": [{"metric": "psu_ok", "op": ">=", "value": 2}],
      "rollback": null,
      "duration_ticks": 8,
      "tags": ["hardware", "power", "dc-ops"]
    },
    {
      "id": "replace_disk",
      "tier": "DESTRUCTIVE",
      "description": "Pull and replace the failing disk (data on that disk is lost)",
      "effects": [{"op": "clear_faults", "faults": ["disk_failing", "disk_latency", "nvme_wear"]}],
      "preconditions": ["host_drained", "ticket_open"],
      "verify": [{"metric": "smart_realloc", "op": "<", "value": 100}],
      "rollback": null,
      "duration_ticks": 10,
      "tags": ["hardware", "storage", "dc-ops"]
    },
    {
      "id": "replace_dimm",
      "tier": "DESTRUCTIVE",
      "description": "Power off and swap the faulty DIMM (memory contents lost)",
      "effects": [{"op": "clear_faults", "faults": ["ecc_correctable", "ecc_uncorrectable"]}],
      "preconditions": ["host_drained", "ticket_open"],
      "verify": [{"metric": "ecc_ce_per_h", "op": "<", "value": 100}, {"metric": "ecc_ue", "op": "<", "value": 1}],
      "rollback": null,
      "duration_ticks": 10,
      "tags": ["hardware", "memory", "dc-ops"]
    },
    {
      "id": "reimage_host",
      "tier": "DESTRUCTIVE",
      "description": "Wipe and reprovision the OS from the golden image",
      "effects": [{"op": "clear_faults", "faults": ["service_down", "memory_leak", "oom_kills", "zombie_growth", "kernel_soft_lockup", "swap_exhaustion", "ntp_drift", "ssh_unreachable", "firmware_mismatch", "cert_expiry", "inode_exhaustion"]}],
      "preconditions": ["host_drained", "bmc_reachable"],
      "verify": [{"metric": "ssh_reachable", "op": ">=", "value": 1}, {"metric": "service_up", "op": ">=", "value": 1}],
      "rollback": null,
      "duration_ticks": 12,
      "tags": ["software", "provisioning"]
    },
    {
      "id": "decommission_host",
      "tier": "DESTRUCTIVE",
      "description": "Remove the host from the fleet for RMA (irreversible)",
      "effects": [{"op": "set_state", "field": "decommissioned", "value": true}, {"op": "clear_all_faults"}],
      "preconditions": ["host_drained", "ticket_open"],
      "verify": [{"state": "decommissioned", "equals": true}],
      "rollback": null,
      "duration_ticks": 1,
      "tags": ["hardware", "lifecycle"]
    },
    {
      "id": "failover_db_primary",
      "tier": "DESTRUCTIVE",
      "description": "Promote a replica and demote this primary (irreversible role change)",
      "effects": [{"op": "set_state", "field": "role", "value": "db-replica"}],
      "preconditions": ["role:db-primary"],
      "verify": [{"state": "role", "equals": "db-replica"}],
      "rollback": null,
      "duration_ticks": 2,
      "tags": ["database"]
    }
  ],
  "playbooks": {
    "thermal": ["set_fan_profile_max"],
    "cooling_failure": ["throttle_workload", "open_ticket"],
    "fan_failure": ["open_ticket", "replace_fan"],
    "cpu_throttling": ["throttle_workload"],
    "service_down": ["restart_service"],
    "nic_errors": ["reset_nic"],
    "ecc_correctable": ["drain_host", "open_ticket"],
    "ecc_uncorrectable": ["drain_host", "open_ticket", "replace_dimm"],
    "disk_failing": ["drain_host", "open_ticket", "replace_disk"],
    "psu_failure": ["open_ticket", "replace_psu"],
    "memory_leak": ["restart_service"],
    "oom_kills": ["restart_service"],
    "kernel_soft_lockup": ["drain_host", "reboot_host", "undrain_host"],
    "ntp_drift": ["resync_ntp"],
    "raid_degraded": ["open_ticket", "raid_rebuild"],
    "bmc_unreachable": ["reset_bmc", "open_ticket"],
    "disk_latency": ["drain_host", "open_ticket"],
    "packet_loss": ["reset_nic"],
    "uplink_loss": ["failover_tor_uplink", "open_ticket"],
    "link_flap": ["reset_nic", "open_ticket"],
    "firmware_mismatch": ["drain_host", "firmware_update", "undrain_host"],
    "cert_expiry": ["rotate_cert"],
    "ssh_unreachable": ["drain_host", "power_cycle_host", "undrain_host"],
    "zombie_growth": ["kill_zombie_processes"],
    "swap_exhaustion": ["swapoff_swapon"],
    "inode_exhaustion": ["purge_inode_tmp"],
    "gpu_xid": ["drain_host", "reset_gpu", "undrain_host"],
    "nvme_wear": ["open_ticket", "drain_host", "replace_disk"]
  },
  "group_playbooks": {
    "tor_switch_failure": ["failover_tor_uplink", "open_ticket"],
    "pdu_failure": ["open_ticket"],
    "cooling_failure": ["throttle_workload", "open_ticket"],
    "management_network_failure": ["open_ticket"],
    "ntp_source_failure": ["resync_ntp"]
  }
}
