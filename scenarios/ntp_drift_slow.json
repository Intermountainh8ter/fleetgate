{
  "name": "ntp_drift_slow",
  "description": "A clock drifts toward multi-second offset over ten ticks.",
  "fleet": {"hosts": 30, "seed": 108},
  "ticks": 30,
  "policy": "default",
  "tags": ["time", "gradual", "reversible"],
  "events": [
    {"tick": 3, "type": "inject", "host": {"role": "worker", "nth": 8}, "fault": "ntp_drift"}
