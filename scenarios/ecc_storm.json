{
  "name": "ecc_storm",
  "description": "A correctable-ECC storm on a worker: contain it and hand the DIMM to DC-ops.",
  "fleet": {"hosts": 30, "seed": 114},
  "ticks": 25,
  "policy": "default",
  "tags": ["hardware", "contained"],
  "events": [
    {"tick": 3, "type": "inject", "host": {"role": "worker", "nth": 3}, "fault": "ecc_correctable"}
  ],
  "expect": {
    "approve_all": {"min": {"faults_detected": 1, "faults_resolved": 0, "faults_contained": 1}, "max": {"spurious_incidents": 0, "pages": 0, "verify_failures": 0, "max_drained_fraction": 0.033}},
    "deny_all": {"min": {"faults_detected": 1, "faults_resolved": 0, "faults_contained": 1}, "max": {"spurious_incidents": 0, "pages": 0, "verify_failures": 0, "max_drained_fraction": 0.033}}
  }
}
