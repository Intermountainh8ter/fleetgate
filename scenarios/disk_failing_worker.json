{
  "name": "disk_failing_worker",
  "description": "SMART reallocations climb on a worker's disk: drain, ticket, a two-person-approved disk swap, return.",
  "fleet": {"hosts": 30, "seed": 112},
  "ticks": 40,
  "policy": "default",
  "tags": ["hardware", "destructive", "approval"],
  "events": [
    {"tick": 3, "type": "inject", "host": {"role": "worker", "nth": 2}, "fault": "disk_failing"}
  ],
  "expect": {
    "approve_all": {"min": {"faults_detected": 1, "faults_resolved": 1, "faults_contained": 0}, "max": {"spurious_incidents": 0, "pages": 0, "verify_failures": 0, "max_drained_fraction": 0.033}},
    "deny_all": {"min": {"faults_detected": 1, "faults_resolved": 0, "faults_contained": 1}, "max": {"spurious_incidents": 0, "pages": 1, "verify_failures": 0, "max_drained_fraction": 0.033}}
  }
}
