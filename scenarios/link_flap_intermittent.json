{
  "name": "link_flap_intermittent",
  "description": "A link bounces on and off; the intermittent signal still has to cross the confirm window.",
  "fleet": {"hosts": 30, "seed": 123},
  "ticks": 30,
  "policy": "default",
  "tags": ["network", "intermittent"],
  "events": [
    {"tick": 3, "type": "inject", "host": {"role": "worker", "nth": 1}, "fault": "link_flap"}
  ],
  "expect": {
    "approve_all": {"min": {"faults_detected": 1, "faults_resolved": 1, "faults_contained": 0}, "max": {"spurious_incidents": 0, "pages": 0, "verify_failures": 0, "max_drained_fraction": 0.0}},
    "deny_all": {"min": {"faults_detected": 1, "faults_resolved": 1, "faults_contained": 0}, "max": {"spurious_incidents": 0, "pages": 0, "verify_failures": 0, "max_drained_fraction": 0.0}}
  }
}
