{
  "name": "nic_errors_burst",
  "description": "CRC errors on one NIC arrive intermittently (50% duty); a NIC reset clears them.",
  "fleet": {"hosts": 30, "seed": 122},
  "ticks": 25,
  "policy": "default",
  "tags": ["network", "intermittent", "reversible"],
  "events": [
    {"tick": 3, "type": "inject", "host": {"role": "worker", "nth": 0}, "fault": "nic_errors", "mode": "intermittent", "duty": 0.75, "period": 4}
  ],
  "expect": {
    "approve_all": {"min": {"faults_detected": 1, "faults_resolved": 1, "faults_contained": 0}, "max": {"spurious_incidents": 0, "pages": 0, "verify_failures": 0, "max_drained_fraction": 0.0}},
    "deny_all": {"min": {"faults_detected": 1, "faults_resolved": 1, "faults_contained": 0}, "max": {"spurious_incidents": 0, "pages": 0, "verify_failures": 0, "max_drained_fraction": 0.0}}
  }
}
