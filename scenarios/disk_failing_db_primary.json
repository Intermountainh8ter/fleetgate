{
  "name": "disk_failing_db_primary",
  "description": "The same disk failure, but on the database primary: capacity floor and protected approvals bite.",
  "fleet": {"hosts": 30, "seed": 108},
  "ticks": 60,
  "policy": "default",
  "tags": ["hardware", "destructive", "protected"],
  "events": [
    {"tick": 3, "type": "inject", "host": {"role": "db-primary", "nth": 0}, "fault": "disk_failing"}
  ],
  "expect": {
    "approve_all": {"min": {"faults_detected": 1, "faults_resolved": 1, "faults_contained": 0}, "max": {"spurious_incidents": 0, "pages": 0, "verify_failures": 0, "max_drained_fraction": 0.033}},
    "deny_all": {"min": {"faults_detected": 1, "faults_resolved": 0, "faults_contained": 0}, "max": {"spurious_incidents": 0, "pages": 1, "verify_failures": 0, "max_drained_fraction": 0.0}}
  }
}
