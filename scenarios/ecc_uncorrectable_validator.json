{
  "name": "ecc_uncorrectable_validator",
  "description": "An uncorrectable ECC error on a validator: the next one panics the kernel.",
  "fleet": {"hosts": 30, "seed": 108},
  "ticks": 40,
  "policy": "default",
  "tags": ["hardware", "destructive", "protected", "capacity-floor"],
  "events": [
    {"tick": 3, "type": "inject", "host": {"role": "validator", "nth": 0}, "fault": "ecc_uncorrectable"}
  ],
  "expect": {
    "approve_all": {"min": {"faults_detected": 1, "faults_resolved": 0, "faults_contained": 0}, "max": {"spurious_incidents": 0, "pages": 1, "verify_failures": 0, "max_drained_fraction": 0.0}},
    "deny_all": {"min": {"faults_detected": 1, "faults_resolved": 0, "faults_contained": 0}, "max": {"spurious_incidents": 0, "pages": 1, "verify_failures": 0, "max_drained_fraction": 0.0}}
  }
}
