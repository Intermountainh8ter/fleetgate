{
  "name": "zombie_growth_slow",
  "description": "A parent stops reaping children: zombie processes pile up slowly.",
  "fleet": {"hosts": 30, "seed": 104},
  "ticks": 40,
  "policy": "default",
  "tags": ["software", "gradual"],
  "events": [
    {"tick": 3, "type": "inject", "host": {"role": "worker", "nth": 4}, "fault": "zombie_growth"}
