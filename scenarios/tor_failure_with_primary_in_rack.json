{
  "name": "tor_failure_with_primary_in_rack",
  "description": "A ToR failure in a rack that holds the database primary: the rack-wide fix needs protected approvals.",
  "fleet": {"hosts": 30, "seed": 2},
  "ticks": 30,
  "policy": "default",
  "tags": ["rack", "correlated", "protected"],
  "events": [
    {"tick": 4, "type": "inject_rack", "rack": {"index": 1}}
  ],
  "expect": {
    "approve_all": {"min": {"faults_detected": 10, "faults_resolved": 10, "faults_contained": 0}, "max": {"spurious_incidents": 0, "pages": 0, "verify_failures": 0, "max_drained_fraction": 0.0}},
    "deny_all": {"min": {"faults_detected": 10, "faults_resolved": 0, "faults_contained": 0}, "max": {"spurious_incidents": 0, "pages": 1, "verify_failures": 0, "max_drained_fraction": 0.0}}
  }
}
