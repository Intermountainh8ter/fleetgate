{
  "name": "raid_degraded_storage",
  "description": "A RAID member drops on a storage node; a rebuild is disruptive.",
  "fleet": {"hosts": 30, "seed": 117},
  "ticks": 40,
  "policy": "default",
  "tags": ["hardware", "disruptive"],
  "events": [
    {"tick": 3, "type": "inject", "host": {"role": "storage", "nth": 0}, "fault": "raid_degraded"}
  ],
  "expect": {
    "approve_all": {"min": {"faults_detected": 1, "faults_resolved": 1, "faults_contained": 0}, "max": {"spurious_incidents": 0, "pages": 0, "verify_failures": 0, "max_drained_fraction": 0.0}},
    "deny_all": {"min": {"faults_detected": 1, "faults_resolved": 0, "faults_contained": 0}, "max": {"spurious_incidents": 0, "pages": 1, "verify_failures": 0, "max_drained_fraction": 0.0}}
  }
}
